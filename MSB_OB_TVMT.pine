// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © EmreKb
//
// ORIGINAL WORK: "Market Structure Break & Order Block" (MSB-OB) © EmreKb — MPL-2.0
// THIS FILE:     the same script with a TVMT webhook alert added, also MPL-2.0.
//
// WHAT WAS CHANGED, AND NOTHING ELSE:
//
//   1. ADDED  BUY and SELL signals, drawn as labels and sent to the webhook.
//             Two triggers, selectable: "Zone Rejection" (default) waits for
//             price to retest a zone and take the first candle that closes back
//             out of it the zone's own way; "Structure Break" is the original
//             market flip, with no retest.
//
//   2. ADDED  two ways to reach TVMT, which must never both be live at once:
//             a single alert() on "Any alert() function call" that writes
//             braced JSON itself, or the MSB BUY / MSB SELL alertconditions
//             that carry TVMT's own brace-less placeholder format.
//
//   3. GATED  the four existing zone alerts behind a toggle, default OFF.
//             This one is not optional. TradingView's "Any alert() function
//             call" condition fires on EVERY alert() in the script, so those
//             four would post "Price in the BU-OB zone" — plain text, not JSON —
//             into the same webhook as the trade signals. Worse, the zone tests
//             are levels rather than edges, so they fire on every bar while
//             price sits inside a box. Left as they were, they would bury the
//             BUY/SELL messages under unparseable ones.
//
//   The signal engine, zigzag, order blocks, breaker blocks, drawings, inputs
//   and Pine version are untouched.
//
// ALERT SETUP (once):
//   Right-click chart → Add alert
//     → Condition: "MSB-OB"  →  "Any alert() function call"
//     → Notifications → Webhook URL → your TVMT bridge URL
//     → Leave the message box alone; the script writes it.
//
//   The payload carries no sl/tp — TVMT applies its own from Trading Setup.
//
//   TradingView freezes BOTH the script AND its input settings into an alert
//   at the moment you create it. Changing either afterwards does not update a
//   running alert: delete it and create a new one, or the bridge keeps trading
//   the old configuration.

//@version=5
indicator("Market Structure Break & Order Block", "MSB-OB", overlay=true, max_lines_count=500, max_labels_count=500, max_bars_back=4900, max_boxes_count=500)

settings = "Settings"
zigzag_len = input.int(9, "ZigZag Length", group=settings)
show_zigzag = input.bool(true, "Show Zigzag", group=settings)
fib_factor = input.float(0.33, "Fib Factor for breakout confirmation", 0, 1, 0.01, group=settings)

text_size = input.string(size.tiny, "Text Size", [size.tiny, size.small, size.normal, size.large, size.huge], group=settings)

delete_boxes = input.bool(true, "Delete Old/Broken Boxes", group=settings)

// ---------------------------------------------------------------------------
//  BUY / SELL SIGNALS  (added)
//
//  The original engine already decides direction - market flips to 1 on a
//  bullish structure break and to -1 on a bearish one - but it only ever drew
//  an "MSB" tag back at the broken swing. These labels mark the break bar
//  itself, so the entry the alert fires on is the one you can see.
// ---------------------------------------------------------------------------
signal_settings = "BUY / SELL Signals"
show_signals = input.bool(true, "Show BUY / SELL Labels", group=signal_settings)
buy_color = input.color(color.green, "BUY", group=signal_settings, inline="buy")
buy_text_color = input.color(color.white, "Text", group=signal_settings, inline="buy")
sell_color = input.color(color.red, "SELL", group=signal_settings, inline="sell")
sell_text_color = input.color(color.white, "Text", group=signal_settings, inline="sell")
signal_size = input.string(size.small, "Label Size", [size.tiny, size.small, size.normal, size.large], group=signal_settings)
signal_mode = input.string("Zone Rejection", "Signal Trigger", ["Zone Rejection", "Structure Break (original)"], group=signal_settings, tooltip="Zone Rejection: price must first trade INTO a zone, then the first candle that closes back out of it in the zone's own direction is the signal - an up candle closing above a green box is a BUY, a down candle closing below a red box is a SELL. This is the retest entry.\n\nStructure Break (original): fires the moment market structure flips, with no retest. Kept so the two can be compared.")
zone_touch = input.string("Wick Touches Zone", "Zone Contact", ["Wick Touches Zone", "Close Inside Zone"], group=signal_settings, tooltip="Wick Touches Zone (default): the bar's RANGE only has to reach into the zone, and the signal is that same bar closing back out of it. This is the single rejection candle - price pokes the zone and is thrown back.\n\nClose Inside Zone: price must actually CLOSE inside the zone on one bar and close back out on a later one. Much stricter, and at resistance it rarely triggers at all, because a rejection candle usually wicks the zone and closes below it.")
zone_kind = input.string("Both", "Zones Used For Signals", ["Both", "Order Blocks only", "Breaker Blocks only"], group=signal_settings, tooltip="Which boxes count as a zone: the Bu-OB / Be-OB order blocks, the Bu-BB / Be-BB breaker blocks, or both.")

// ---------------------------------------------------------------------------
//  TVMT ALERTS  (added)
// ---------------------------------------------------------------------------
tvmt_settings = "TVMT Alerts"
tvmt_on = input.bool(true, "Send BUY / SELL Alerts To TVMT", group=tvmt_settings, tooltip="Controls the alert() route only - the single \"Any alert() function call\" alert. Untick it to silence that route without deleting anything, which is what you want if you switch to the two MSB BUY / MSB SELL alertconditions instead. The alertconditions are compile-time and ignore this toggle; they only fire if you create an alert on them.\n\nSilences the webhook without deleting the alert. Remember TradingView froze this setting into the alert when you created it — changing it here only affects a NEWLY created alert.")
sym_override = input.string("", "Webhook Symbol Override", group=tvmt_settings, tooltip="Leave empty to send the chart's own ticker. A TVC:GOLD chart sends \"GOLD\", which will not match a broker account trading XAUUSD — type the broker's exact symbol here to send that instead. Only needed if TVMT's auto-detect misses.")
alert_intrabar = input.bool(true, "Fire Alert Intrabar (do not wait for bar close)", group=tvmt_settings, tooltip="ON: the alert fires the moment the condition first becomes true inside the bar - TradingView's \"once per bar\" behaviour. Faster entry, which matters when the target is small.\n\nThe cost is that the signal can un-happen. The condition reads the LIVE close, so price can be above the zone on a green candle when the alert fires and back below by the time the bar shuts. The trade is open; the chart label is gone. You saw the mirror image of this earlier - a label with no trade - and this is the same thing from the other side.\n\nOFF: fires only on a closed bar. What prints is what traded.\n\nNote the Win Rate dashboard can only ever replay closed bars, so with this ON it measures a slightly different strategy from the one being traded."
zone_alerts = input.bool(false, "Also Send Order Block Zone Alerts", group=tvmt_settings, tooltip="OFF by default, and it should stay off on any alert wired to a trading webhook.\n\nThese four alerts send PLAIN TEXT (\"Price in the BU-OB zone\"), not JSON, and TradingView's \"Any alert() function call\" condition fires on every alert() in the script — so they go to the same webhook as your trades. They also test a LEVEL rather than an edge, so they fire on every bar while price sits inside a box.\n\nTurn on only for a separate, notification-only alert.")

bu_ob_inline_color = "Bu-OB Colors"
be_ob_inline_color = "Be-OB Colors"
bu_bb_inline_color = "Bu-BB Colors"
be_bb_inline_color = "Be-BB Colors"

bu_ob_display_settings = "Bu-OB Display Settings"
bu_ob_color = input.color(color.new(color.green, 70), "Color", group=bu_ob_display_settings, inline=bu_ob_inline_color)
bu_ob_border_color = input.color(color.green, "Border Color", group=bu_ob_display_settings, inline=bu_ob_inline_color)
bu_ob_text_color = input.color(color.green, "Text Color", group=bu_ob_display_settings, inline=bu_ob_inline_color)

be_ob_display_settings = "Be-OB Display Settings"
be_ob_color = input.color(color.new(color.red, 70), "Color", group=be_ob_display_settings, inline=be_ob_inline_color)
be_ob_border_color = input.color(color.red, "Border Color", group=be_ob_display_settings, inline=be_ob_inline_color)
be_ob_text_color = input.color(color.red, "Text Color", group=be_ob_display_settings, inline=be_ob_inline_color)

bu_bb_display_settings = "Bu-BB & Bu-MB Display Settings"
bu_bb_color = input.color(color.new(color.green, 70), "Color", group=bu_bb_display_settings, inline=bu_bb_inline_color)
bu_bb_border_color = input.color(color.green, "Border Color", group=bu_bb_display_settings, inline=bu_bb_inline_color)
bu_bb_text_color = input.color(color.green, "Text Color", group=bu_bb_display_settings, inline=bu_bb_inline_color)

be_bb_display_settings = "Be-BB & Be-MB Display Settings"
be_bb_color = input.color(color.new(color.red, 70), "Color", group=be_bb_display_settings, inline=be_bb_inline_color)
be_bb_border_color = input.color(color.red, "Border Color", group=be_bb_display_settings, inline=be_bb_inline_color)
be_bb_text_color = input.color(color.red, "Text Color", group=be_bb_display_settings, inline=be_bb_inline_color)


var float[] high_points_arr = array.new_float(5)
var int[] high_index_arr = array.new_int(5)
var float[] low_points_arr = array.new_float(5)
var int[] low_index_arr = array.new_int(5)

var box[] bu_ob_boxes = array.new_box(5)
var box[] be_ob_boxes = array.new_box(5)
var box[] bu_bb_boxes = array.new_box(5)
var box[] be_bb_boxes = array.new_box(5)

to_up = high >= ta.highest(zigzag_len)
to_down = low <= ta.lowest(zigzag_len)

trend = 1
trend := nz(trend[1], 1)
trend := trend == 1 and to_down ? -1 : trend == -1 and to_up ? 1 : trend

last_trend_up_since = ta.barssince(to_up[1])
low_val = ta.lowest(nz(last_trend_up_since > 0 ? last_trend_up_since : 1, 1))
low_index = bar_index - ta.barssince(low_val == low)

last_trend_down_since = ta.barssince(to_down[1])
high_val = ta.highest(nz(last_trend_down_since > 0 ? last_trend_down_since : 1, 1))
high_index = bar_index - ta.barssince(high_val == high)

if ta.change(trend) != 0
    if trend == 1
        array.push(low_points_arr, low_val)
        array.push(low_index_arr, low_index)
    if trend == -1
        array.push(high_points_arr, high_val)
        array.push(high_index_arr, high_index)


f_get_high(ind) =>
    [array.get(high_points_arr, array.size(high_points_arr) - 1 - ind), array.get(high_index_arr, array.size(high_index_arr) - 1 - ind)]


f_get_low(ind) =>
    [array.get(low_points_arr, array.size(low_points_arr) - 1 - ind), array.get(low_index_arr, array.size(low_index_arr) - 1 - ind)]


f_delete_box(box_arr) =>
    if delete_boxes
        box.delete(array.shift(box_arr))
    else
        array.shift(box_arr)
    0


// TVMT payload. No sl/tp: the bridge applies its own from Trading Setup.
// tv_alert_id uses the BAR time, so a repeat of the same bar is recognisable
// as a duplicate by the receiving end.
f_tvmt_json(action) =>
    sym = str.length(sym_override) > 0 ? sym_override : syminfo.ticker
    '{"symbol": "' + sym + '", "action": "' + action + '", "tv_time": "' + str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '", "tv_alert_id": "tv-' + sym + '-' + action + '-' + str.tostring(time) + '"}'


// Is close currently inside any box in this array, and if so what are the
// outer edges of the box(es) it is in? The na guard matters: array.new_box(5)
// pre-fills five na boxes that box.get_top() would throw on.
f_zone_scan(box_arr) =>
    bool inside = false      // the CLOSE sits within the box
    bool touched = false     // the bar's RANGE reaches into the box
    float t = na
    float b = na
    if array.size(box_arr) > 0
        for i = 0 to array.size(box_arr) - 1
            bx = array.get(box_arr, i)
            if not na(bx)
                float bx_t = box.get_top(bx)
                float bx_b = box.get_bottom(bx)
                if low <= bx_t and high >= bx_b
                    touched := true
                    t := na(t) ? bx_t : math.max(t, bx_t)
                    b := na(b) ? bx_b : math.min(b, bx_b)
                if close <= bx_t and close >= bx_b
                    inside := true
    [inside, touched, t, b]


[h0, h0i] = f_get_high(0)
[h1, h1i] = f_get_high(1)

[l0, l0i] = f_get_low(0)
[l1, l1i] = f_get_low(1)

if ta.change(trend) != 0 and show_zigzag
    if trend == 1
        line.new(h0i, h0, l0i, l0)
    if trend == -1
        line.new(l0i, l0, h0i, h0)

market = 1
market := nz(market[1], 1)
// market := market == 1 and close < l0 and low < l0 - math.abs(h0 - l0) * fib_factor ? -1 : market == -1 and close > h0 and high > h0 + math.abs(h0 - l0) * fib_factor ? 1 : market
last_l0 = ta.valuewhen(ta.change(market) != 0, l0, 0)
last_h0 = ta.valuewhen(ta.change(market) != 0, h0, 0)
market := last_l0 == l0 or last_h0 == h0 ? market : market == 1 and l0 < l1 and l0 < l1 - math.abs(h0 - l1) * fib_factor ? -1 : market == -1 and h0 > h1 and h0 > h1 + math.abs(h1 - l0) * fib_factor ? 1 : market

bu_ob_index = bar_index
bu_ob_index := nz(bu_ob_index[1], bar_index)
for i=h1i to l0i[zigzag_len]
    index = bar_index - i
    if open[index] > close[index]
        bu_ob_index := bar_index[index]

bu_ob_since = bar_index - bu_ob_index

be_ob_index = bar_index
be_ob_index := nz(be_ob_index[1], bar_index)
for i=l1i to h0i[zigzag_len]
    index = bar_index - i
    if open[index] < close[index]
        be_ob_index := bar_index[index]

be_ob_since = bar_index - be_ob_index

be_bb_index = bar_index
be_bb_index := nz(be_bb_index[1], bar_index)
for i=h1i - zigzag_len to l1i
    index = bar_index - i
    if open[index] > close[index]
        be_bb_index := bar_index[index]

be_bb_since = bar_index - be_bb_index

bu_bb_index = bar_index
bu_bb_index := nz(bu_bb_index[1], bar_index)
for i=l1i - zigzag_len to h1i
    index = bar_index - i
    if open[index] < close[index]
        bu_bb_index := bar_index[index]

bu_bb_since = bar_index - bu_bb_index

if ta.change(market) != 0
    if market == 1
        line.new(h1i, h1, h0i, h1, color=color.green, width=2)
        label.new(int(math.avg(h1i, l0i)), h1, "MSB", color=color.new(color.black, 100), style=label.style_label_down, textcolor=color.green, size=size.small)
        bu_ob = box.new(bu_ob_index, high[bu_ob_since], bar_index + 10, low[bu_ob_since], bgcolor=bu_ob_color, border_color=bu_ob_border_color, text="Bu-OB", text_color=bu_ob_text_color, text_halign=text.align_right, text_size=text_size)
        bu_bb = box.new(bu_bb_index, high[bu_bb_since], bar_index + 10, low[bu_bb_since], bgcolor=bu_bb_color, border_color=bu_bb_border_color, text=l0 < l1 ? "Bu-BB" : "Bu-MB", text_color=bu_bb_text_color, text_halign=text.align_right, text_size=text_size)
        array.push(bu_ob_boxes, bu_ob)
        array.push(bu_bb_boxes, bu_bb)
    if market == -1
        line.new(l1i, l1, l0i, l1, color=color.red, width=2)
        label.new(int(math.avg(l1i, h0i)), l1, "MSB", color=color.new(color.black, 100), style=label.style_label_up, textcolor=color.red, size=size.small)
        be_ob = box.new(be_ob_index, high[be_ob_since], bar_index + 10, low[be_ob_since], bgcolor=be_ob_color, border_color=be_ob_border_color, text="Be-OB", text_color=be_ob_text_color, text_halign=text.align_right, text_size=text_size)
        be_bb = box.new(be_bb_index, high[be_bb_since], bar_index + 10, low[be_bb_since], bgcolor=be_bb_color, border_color=be_bb_border_color, text=h0 > h1 ? "Be-BB" : "Be-MB", text_color=be_bb_text_color, text_halign=text.align_right, text_size=text_size)
        array.push(be_ob_boxes, be_ob)
        array.push(be_bb_boxes, be_bb)

// ---------------------------------------------------------------------------
//  ZONE REJECTION SIGNALS  (added)
//
//  Read BEFORE the maintenance loops below, because those delete broken boxes
//  and would erase the zone we are measuring against.
//
//  A signal needs three things to line up on one bar:
//    1. price was INSIDE a zone on the previous bar   (the retest)
//    2. it has closed back OUT of that zone this bar  (the rejection)
//    3. the candle points the zone's way - up out of green, down out of red
//
//  Condition 3 is what stops a green box being read as a BUY when price has
//  actually collapsed through the bottom of it. Leaving a zone downward on a
//  bullish candle is a broken zone, not an entry, so the close is compared
//  against the edge price was defending.
// ---------------------------------------------------------------------------
use_ob = zone_kind != "Breaker Blocks only"
use_bb = zone_kind != "Order Blocks only"

[cl_bu_ob, tc_bu_ob, bu_ob_t, bu_ob_b] = f_zone_scan(bu_ob_boxes)
[cl_bu_bb, tc_bu_bb, bu_bb_t, bu_bb_b] = f_zone_scan(bu_bb_boxes)
[cl_be_ob, tc_be_ob, be_ob_t, be_ob_b] = f_zone_scan(be_ob_boxes)
[cl_be_bb, tc_be_bb, be_bb_t, be_bb_b] = f_zone_scan(be_bb_boxes)

// Edges of whichever zones this bar reached into.
bull_t_ob = use_ob ? bu_ob_t : na
bull_t_bb = use_bb ? bu_bb_t : na
bull_zone_top = na(bull_t_ob) ? bull_t_bb : na(bull_t_bb) ? bull_t_ob : math.max(bull_t_ob, bull_t_bb)

bear_b_ob = use_ob ? be_ob_b : na
bear_b_bb = use_bb ? be_bb_b : na
bear_zone_bot = na(bear_b_ob) ? bear_b_bb : na(bear_b_bb) ? bear_b_ob : math.min(bear_b_ob, bear_b_bb)

touch_bull = (use_ob and tc_bu_ob) or (use_bb and tc_bu_bb)
touch_bear = (use_ob and tc_be_ob) or (use_bb and tc_be_bb)
close_bull = (use_ob and cl_bu_ob) or (use_bb and cl_bu_bb)
close_bear = (use_ob and cl_be_ob) or (use_bb and cl_be_bb)

// --- Wick mode: the rejection is one candle -------------------------------
// The bar reaches into the zone and closes back out of it the zone's way. This
// is what a rejection at resistance actually looks like - the close is almost
// never inside, only the wick is.
wick_buy = touch_bull and close > open and not na(bull_zone_top) and close > bull_zone_top
wick_sell = touch_bear and close < open and not na(bear_zone_bot) and close < bear_zone_bot

// --- Close mode: the stricter two-bar version -----------------------------
// The edge has to be remembered, because by the bar price breaks out the scan
// no longer reports the box it just left.
var float held_bull_top = na
var float held_bear_bot = na
if close_bull
    held_bull_top := bull_zone_top
if close_bear
    held_bear_bot := bear_zone_bot

close_buy = close_bull[1] and not close_bull and close > open and not na(held_bull_top) and close > held_bull_top
close_sell = close_bear[1] and not close_bear and close < open and not na(held_bear_bot) and close < held_bear_bot

if close_buy
    held_bull_top := na
if close_sell
    held_bear_bot := na

wick_mode = zone_touch == "Wick Touches Zone"
bull_reject = wick_mode ? wick_buy : close_buy
bear_reject = wick_mode ? wick_sell : close_sell

zone_mode = signal_mode == "Zone Rejection"
buy_signal = zone_mode ? bull_reject : (ta.change(market) != 0 and market == 1)
sell_signal = zone_mode ? bear_reject : (ta.change(market) != 0 and market == -1)

if show_signals and buy_signal
    label.new(bar_index, low, "BUY", yloc=yloc.belowbar, style=label.style_label_up, color=buy_color, textcolor=buy_text_color, size=signal_size)
if show_signals and sell_signal
    label.new(bar_index, high, "SELL", yloc=yloc.abovebar, style=label.style_label_down, color=sell_color, textcolor=sell_text_color, size=signal_size)


for bull_ob in bu_ob_boxes
    bottom = box.get_bottom(bull_ob)
    top = box.get_top(bull_ob)
    if close < bottom
        f_delete_box(bu_ob_boxes)
    else if close < top
        if zone_alerts
            alert("Price in the BU-OB zone")
    else
        box.set_right(bull_ob, bar_index + 10)

for bear_ob in be_ob_boxes
    top = box.get_top(bear_ob)
    bottom = box.get_bottom((bear_ob))
    if close > top
        f_delete_box(be_ob_boxes)
    if close > bottom
        if zone_alerts
            alert("Price in the BE-OB zone")
    else
        box.set_right(bear_ob, bar_index + 10)

for bear_bb in be_bb_boxes
    top = box.get_top(bear_bb)
    bottom = box.get_bottom(bear_bb)
    if close > top
        f_delete_box(be_bb_boxes)
    else if close > bottom
        if zone_alerts
            alert("Price in the BE-BB zone")
    else
        box.set_right(bear_bb, bar_index + 10)

for bull_bb in bu_bb_boxes
    bottom = box.get_bottom(bull_bb)
    top = box.get_top(bull_bb)
    if close < bottom
        f_delete_box(bu_bb_boxes)
    else if close < top
        if zone_alerts
            alert("Price in the BU-BB zone")
    else
        box.set_right(bull_bb, bar_index + 10)


alertcondition(ta.change(market) != 0, "MSB", "MSB")

// ---------------------------------------------------------------------------
//  TVMT BUY / SELL ALERTCONDITIONS  (added)
//
//  TVMT's own message format: no outer braces, and TradingView placeholders
//  instead of values assembled in Pine. {{ticker}}, {{timenow}} and {{time}}
//  only resolve inside an alert MESSAGE, which is exactly why this route has
//  to be alertcondition() and cannot be alert().
//
//  TradingView pre-fills the message box from the string below, so there is
//  nothing to paste and nothing to mistype. Leave that box alone.
//
//  THERE ARE NOW TWO ROUTES, AND THEY MUST NOT BOTH BE LIVE:
//    A)  ONE alert on "Any alert() function call"  - the script writes braced
//        JSON itself, and honours Webhook Symbol Override.
//    B)  TWO alerts on the conditions below        - TradingView fills in the
//        brace-less format above. {{ticker}} cannot be overridden, so a
//        TVC:GOLD chart sends "GOLD" and TVMT must map it.
//  Running both sends two messages for every signal. Pick one, and delete the
//  alerts belonging to the other.
//
//  Route B also puts the frequency dropdown back in the alert dialog, so
//  "Once Per Bar" - fire as soon as the condition is met - is chosen there
//  rather than being fixed in the script.
// ---------------------------------------------------------------------------
alertcondition(buy_signal, title = "MSB BUY (TVMT)", message = '"symbol": "{{ticker}}",\n"action": "buy",\n"tv_time": "{{timenow}}",\n"tv_alert_id": "tv-{{ticker}}-buy-{{time}}"')

alertcondition(sell_signal, title = "MSB SELL (TVMT)", message = '"symbol": "{{ticker}}",\n"action": "sell",\n"tv_time": "{{timenow}}",\n"tv_alert_id": "tv-{{ticker}}-sell-{{time}}"')

// ---------------------------------------------------------------------------
//  TVMT BUY / SELL ALERT  (added)
//
//  Fires whichever trigger "Signal Trigger" selects, so the webhook and the
//  chart label can never disagree about what a signal is.
//
//  The frequency is set here, not in the alert dialog, so there is no dropdown
//  to get wrong when creating the alert. Either way it is at most one message
//  per bar - intrabar fires on the first tick that satisfies the condition,
//  bar-close waits for the bar to shut.
// ---------------------------------------------------------------------------
// The freq argument has to be a compile-time constant, so the two frequencies
// need separate alert() calls rather than a variable.
if tvmt_on
    if buy_signal
        if alert_intrabar
            alert(f_tvmt_json("buy"), alert.freq_once_per_bar)
        else
            alert(f_tvmt_json("buy"), alert.freq_once_per_bar_close)
    else if sell_signal
        if alert_intrabar
            alert(f_tvmt_json("sell"), alert.freq_once_per_bar)
        else
            alert(f_tvmt_json("sell"), alert.freq_once_per_bar_close)


// ===========================================================================
//  WIN RATE  (added - scoring only, makes no signals and sends no alerts)
//
//  This script deliberately sends no sl/tp, so there is nothing on the chart
//  to score against. The trade outcome is decided entirely by TVMT's Trading
//  Setup, and that is what this models: the fixed SL/TP pips the bridge
//  applies, close-and-reverse on an opposite signal, and Block Duplicate
//  Entries skipping a same-direction signal while a position is already open.
//
//  Those two behaviours matter more than they look. Blocking duplicates means
//  a run of BUYs in one zone is ONE trade, not five, so the raw signal count
//  is not the trade count. And a reversal closes at market rather than at a
//  level, so it scores wherever price happened to be.
//
//  Set the pips below to match TVMT exactly or the number is fiction.
//
//  Judge a configuration on Expectancy, never on Win Rate. Win Rate counts
//  only trades that reached SL or TP; the reversals it leaves out are the
//  ones that tend to be losing, because an opposite signal usually arrives
//  when price has already gone against the position.
// ===========================================================================
wr_settings = "Win Rate (models your TVMT Trading Setup)"
show_wr = input.bool(true, "Show Win Rate Dashboard", group=wr_settings)
wr_pip_mode = input.string("Manual", "Pip Size Mode", ["Auto (10 x mintick)", "Manual"], group=wr_settings, tooltip="Auto computes 10 x mintick, which only lands on the conventional gold pip of 0.10 for a TWO-decimal feed. On a THREE-decimal gold feed it returns 0.01, ten times too small, and every pip figure below is then wrong by that factor. Manual 0.10 is correct for gold either way.")
wr_manual_pip = input.float(0.10, "Manual Pip Size (price units)", minval=0.0, step=0.00001, group=wr_settings)
wr_sl_pips = input.float(80.0, "Stop Loss (pips)", minval=0.1, step=1.0, group=wr_settings, tooltip="Copy the value from TVMT -> Trading Setup -> Stop Loss (SL) Pips.")
wr_tp_pips = input.float(160.0, "Take Profit (pips)", minval=0.1, step=1.0, group=wr_settings, tooltip="Copy the value from TVMT -> Trading Setup -> Take Profit (TP) Pips.")
wr_cost_pips = input.float(3.5, "Round-Turn Cost (pips)", minval=0.0, step=0.1, group=wr_settings, tooltip="Spread plus commission plus entry slippage, charged once against every trade. Measure it rather than guess: compare one real broker fill against the price on the signal candle. 0 reports gross figures.")
wr_block_dup = input.bool(true, "Block Duplicate Entries", group=wr_settings, tooltip="Mirrors the TVMT setting. On: a signal in the direction already held is skipped, so several signals in one zone count as a single trade.")
wr_reverse = input.bool(true, "Close And Reverse On Opposite Signal", group=wr_settings, tooltip="Mirrors TVMT's Opposite-signal handling. On: the opposite signal closes the open trade at that bar's close and opens the other way.")
wr_pos_in = input.string("Top Right", "Dashboard Position", ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=wr_settings)

wr_pip = wr_pip_mode == "Manual" ? wr_manual_pip : 10.0 * syminfo.mintick
wr_risk = wr_sl_pips * wr_pip
wr_rew = wr_tp_pips * wr_pip
wr_rr = wr_risk > 0 ? wr_rew / wr_risk : na
wr_costR = wr_risk > 0 ? wr_cost_pips * wr_pip / wr_risk : 0.0

var int wr_pos = 0
var float wr_entry = na
var float wr_sl = na
var float wr_tp = na

var int c_sig = 0
var int c_skip = 0
var int c_trade = 0
var int c_win = 0
var int c_loss = 0
var int c_rev = 0
var float wr_sumR = 0.0

if barstate.isconfirmed and wr_risk > 0
    // Resolve an open trade first, so a bar that both stops out an old trade
    // and signals a new one is counted as the loss it was.
    if wr_pos != 0
        bool hitSL = wr_pos == 1 ? low <= wr_sl : high >= wr_sl
        bool hitTP = wr_pos == 1 ? high >= wr_tp : low <= wr_tp
        // One bar can touch both. Tick order is unknowable, so the level
        // nearer this bar's open is assumed to have been reached first.
        bool slFirst = hitSL and hitTP ? math.abs(open - wr_sl) <= math.abs(open - wr_tp) : hitSL
        if hitSL and slFirst
            c_loss += 1
            wr_sumR += -1.0 - wr_costR
            wr_pos := 0
        else if hitTP
            c_win += 1
            wr_sumR += wr_rr - wr_costR
            wr_pos := 0

    if buy_signal or sell_signal
        c_sig += 1
        int want = buy_signal ? 1 : -1
        if wr_pos == want
            c_skip += 1
        else if wr_pos == -want and not wr_reverse
            c_skip += 1
        else
            if wr_pos == -want
                // Reversal closes at market, so it books whatever R it had.
                wr_sumR += (wr_pos == 1 ? (close - wr_entry) : (wr_entry - close)) / wr_risk - wr_costR
                c_rev += 1
            wr_pos := want
            wr_entry := close
            wr_sl := want == 1 ? close - wr_risk : close + wr_risk
            wr_tp := want == 1 ? close + wr_rew : close - wr_rew
            c_trade += 1

int wr_res = c_win + c_loss
int wr_scored = wr_res + c_rev
float wr_winrate = wr_res > 0 ? 100.0 * c_win / wr_res : na
float wr_exp = wr_scored > 0 ? wr_sumR / wr_scored : na
float wr_bewr = na(wr_rr) ? na : 100.0 / (1.0 + wr_rr)

f_wr_r(v) =>
    na(v) ? "-" : (v >= 0 ? "+" : "") + str.tostring(v, "0.00") + "R"

f_wr_pct(v) =>
    na(v) ? "-" : str.tostring(v, "0.0") + "%"

f_wr_pos(sp) =>
    sp == "Top Left" ? position.top_left : sp == "Bottom Right" ? position.bottom_right : sp == "Bottom Left" ? position.bottom_left : position.top_right

var table wr_tbl = table.new(f_wr_pos(wr_pos_in), 2, 13, bgcolor=color.new(color.black, 20), border_width=0, frame_width=0)

if barstate.islast and show_wr
    hdr = color.new(color.blue, 40)
    bg = color.new(color.black, 20)
    tx = color.white
    gd = color.lime
    bd = color.red
    table.cell(wr_tbl, 0, 0, "WIN RATE", bgcolor=hdr, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 0, str.tostring(wr_sl_pips, "0") + "/" + str.tostring(wr_tp_pips, "0") + (wr_cost_pips > 0 ? " NET" : " GROSS"), bgcolor=hdr, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 0, 1, "Signals", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 1, str.tostring(c_sig), bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 0, 2, "Skipped (duplicate)", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 2, str.tostring(c_skip), bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 0, 3, "Trades taken", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 3, str.tostring(c_trade), bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 0, 4, "Hit TP", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 4, str.tostring(c_win), bgcolor=bg, text_color=gd, text_size=size.small)
    table.cell(wr_tbl, 0, 5, "Hit SL", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 5, str.tostring(c_loss), bgcolor=bg, text_color=bd, text_size=size.small)
    table.cell(wr_tbl, 0, 6, "Closed by reversal", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 6, str.tostring(c_rev), bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 0, 7, "Scored", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 7, str.tostring(wr_scored), bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 0, 8, "Win Rate", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 8, f_wr_pct(wr_winrate), bgcolor=bg, text_color=nz(wr_winrate, 0) >= nz(wr_bewr, 100) ? gd : bd, text_size=size.small)
    table.cell(wr_tbl, 0, 9, "Break-even WR", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 9, f_wr_pct(wr_bewr), bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 0, 10, "Expectancy / trade", bgcolor=hdr, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 10, f_wr_r(wr_exp), bgcolor=hdr, text_color=nz(wr_exp, -1) > 0 ? gd : bd, text_size=size.small)
    table.cell(wr_tbl, 0, 11, "Total R", bgcolor=hdr, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 11, f_wr_r(wr_sumR), bgcolor=hdr, text_color=wr_sumR > 0 ? gd : bd, text_size=size.small)
    table.cell(wr_tbl, 0, 12, "Cost / trade", bgcolor=bg, text_color=tx, text_size=size.small)
    table.cell(wr_tbl, 1, 12, wr_cost_pips <= 0 ? "not counted" : "-" + str.tostring(wr_costR, "0.000") + "R", bgcolor=bg, text_color=wr_cost_pips <= 0 ? bd : tx, text_size=size.small)
