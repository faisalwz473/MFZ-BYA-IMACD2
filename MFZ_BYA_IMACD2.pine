//@version=6
// =============================================================================
//  BYA IMACD1
// -----------------------------------------------------------------------------
//  Signal engine adapted from "Impulse MACD [LazyBear]" (open source, credit to
//  LazyBear). The original was a lower-pane study; this version is an OVERLAY
//  indicator that draws trade levels on the price chart and sends a fixed JSON
//  alert for the TVMT webhook bridge.
//
//  HOW IT WORKS (beginner summary)
//   1. The Impulse MACD line (md, length 10) crossing its signal line
//      (sb, length 3) gives the DIRECTION:
//         md crosses UP through sb   -> long bias
//         md crosses DOWN through sb -> short bias
//      Three alternative modes are kept as options in Settings.
//   2. The cross does NOT decide the entry moment. md is built from
//      ta.rma(high/low, 10), which lags by roughly 19 bars, so the cross
//      confirms after the leg it reports is already finished. Entering at that
//      bar's close means buying the top. Group "1b - Entry Timing" fixes this:
//
//         raw cross -> trend -> extension -> cooldown -> ARM -> pullback -> FILL
//
//      A cross must agree with the trend EMA, must not already be extended
//      beyond N x ATR from the mid line, and must respect a cooldown. It then
//      parks a price and waits for price to retrace to it. Only that FILL is a
//      signal. Turn the four guards off to get the original behaviour back.
//   3. A signal is only accepted when the bar has CLOSED (barstate.isconfirmed),
//      so a printed arrow can never disappear again -> no repainting.
//   4. On the fill bar we capture Entry / SL / TP1 / TP2 / TP3 prices, draw
//      them, and feed them to five hidden plots that the alert reads.
//   5. The alert message is pure JSON built from {{plot("title")}} placeholders,
//      so TVMT always receives raw numbers in the exact expected field names.
//
//  ALERT SETUP (do this once in TradingView)
//   Right-click chart -> Add alert -> Condition: "BYA IMACD1"
//   -> choose "MFZ BUY (TVMT)" or "MFZ SELL (TVMT)"
//   -> Trigger: "Once Per Bar Close"
//   -> The Message box is pre-filled with the JSON. Do not edit it.
//   -> Notifications tab -> Webhook URL -> paste your TVMT bridge URL.
// =============================================================================

indicator(title = "BYA IMACD1", shorttitle = "BYA IMACD1", overlay = true, max_lines_count = 500, max_labels_count = 500, max_bars_back = 1000)

// =============================================================================
//  INPUT GROUPS
//  NOTE: every single input below uses display = display.none. That keeps the
//  chart status line clean (only the indicator name shows), while the inputs
//  still appear normally in Settings -> Inputs.
// =============================================================================
G_SIG   = "1 - Signal Engine (Impulse MACD)"
G_TIME  = "1b - Entry Timing (Late Entry Fix)"
G_DIST  = "2 - Distance Method (SL / TP)"
G_PIP   = "2a - Pip Settings"
G_ATR   = "2b - ATR Settings"
G_PCT   = "2c - Percentage Settings"
G_MARK  = "3 - Marker Style"
G_LINE  = "4 - Line & Label Style"
G_DASH  = "5 - Win Rate Dashboard"
G_ALERT = "6 - Alerts"
G_EXEC  = "7 - Execution Model (mirror TVMT)"

// -----------------------------------------------------------------------------
//  1. SIGNAL ENGINE INPUTS
// -----------------------------------------------------------------------------
lengthMA     = input.int(10, "Impulse MA Length (slow line)", minval = 1, group = G_SIG, tooltip = "Drives the Impulse MACD line (md). Default = 10. LazyBear original used 34.", display = display.none)
lengthSignal = input.int(3, "Signal Line Length (fast line)", minval = 1, group = G_SIG, tooltip = "Drives the signal line (sb). Default = 3. LazyBear original used 9.", display = display.none)
srcInput     = input.source(hlc3, "Price Source", group = G_SIG, display = display.none)
signalMode   = input.string("MACD crosses Signal Line", "Signal Mode", options = ["MACD crosses Signal Line", "Signal Line crosses MACD", "Fast MA crosses Slow MA (price)", "Zero Line Cross"], group = G_SIG, tooltip = "MACD crosses Signal Line (default): the Impulse MACD crossing UP through its signal line = BUY. This matches price direction.\nSignal Line crosses MACD: the reverse orientation, reads backwards against price.\nFast MA crosses Slow MA (price): EMA(3) over EMA(10) on price = BUY.\nZero Line Cross: the Impulse MACD turning positive = BUY.", display = display.none)
invertSig    = input.bool(false, "Invert Buy / Sell", group = G_SIG, tooltip = "Emergency flip. If every marker is on the wrong side, tick this and BUY becomes SELL and SELL becomes BUY, in whichever mode you are using.", display = display.none)
showMAs      = input.bool(false, "Show The Two MAs On Chart", group = G_SIG, tooltip = "Only draws in Fast MA / Slow MA mode, so you can see the crossover on price.", display = display.none)
fastMACol    = input.color(color.aqua, "Fast MA Colour", group = G_SIG, display = display.none)
slowMACol    = input.color(color.orange, "Slow MA Colour", group = G_SIG, display = display.none)
useZone      = input.bool(false, "Require Impulse Zone Confirmation", group = G_SIG, tooltip = "Buy only while price is above the mid band, Sell only while below it. Filters out weak crosses.", display = display.none)
flipOnly     = input.bool(false, "One Signal Per Direction (wait for opposite)", group = G_SIG, tooltip = "Blocks a second Buy before a Sell appears. Keeps one live setup at a time.", display = display.none)

// -----------------------------------------------------------------------------
//  1b. ENTRY TIMING INPUTS  <-- the fix for "the signal fires at the end of the move"
//
//  The raw Impulse MACD cross is a LATE event by construction. md is built from
//  ta.rma(high/low, 10) bands, and Wilder smoothing lags by roughly 2N-1 = 19
//  bars. That already-late value is then crossed against its own 3-bar average.
//  By the time the cross confirms, the leg it is reporting is usually finished,
//  so a market order at that bar's close buys the top or sells the bottom.
//
//  The cross is still the DIRECTION source, but it no longer picks the entry
//  moment. Four guards stand between a cross and an order:
//
//     raw cross -> trend -> extension -> cooldown -> ARM -> pullback -> FILL
//
//  Nothing is drawn and nothing is sent to TVMT until the FILL bar.
//  Switch all four off and the script behaves exactly as it did before.
// -----------------------------------------------------------------------------
useTrend    = input.bool(true, "Trade With The Trend Only", group = G_TIME, tooltip = "Buy only while price is above a rising trend EMA, Sell only while below a falling one. Counter-trend crosses are the ones that reverse fastest.", display = display.none)
trendLen    = input.int(50, "Trend EMA Length", minval = 1, group = G_TIME, tooltip = "Length of the trend EMA. Bigger = stricter. 50 on a 15m chart is roughly half a session.", display = display.none)
useExtFilt  = input.bool(true, "Skip Signals That Are Already Extended", group = G_TIME, tooltip = "THE MAIN LATE-ENTRY FIX. Measures how far the close already sits from the Impulse mid line, in ATR. If the leg has already travelled further than the limit below, the cross is ignored instead of chased.", display = display.none)
maxExtAtr   = input.float(1.5, "Max Distance From Mid Line (x ATR)", minval = 0.1, step = 0.1, group = G_TIME, tooltip = "Lower = stricter = fewer but earlier entries. Start at 1.5, then walk it down to 1.2 / 1.0 while watching Win Rate and Filled on the dashboard.", display = display.none)
usePullback = input.bool(true, "Wait For Pullback Before Entry", group = G_TIME, tooltip = "Instead of firing at the close of the cross bar, the signal is ARMED and only fires once price retraces by the depth below. If price never comes back inside the window, no trade is taken at all.", display = display.none)
pbAtr       = input.float(0.5, "Pullback Depth (x ATR)", minval = 0.0, step = 0.1, group = G_TIME, tooltip = "How far back price must come before the entry is accepted. 0 = fill on the next bar that trades back to the cross bar close.", display = display.none)
pbBars      = input.int(6, "Pullback Window (bars)", minval = 1, group = G_TIME, tooltip = "How long the armed signal waits for its pullback. Expires afterwards and nothing is sent. Raise it if Expired is much larger than Filled.", display = display.none)
entryRef    = input.string("Fill bar close (market order)", "Entry Price Sent To TVMT", options = ["Fill bar close (market order)", "Pullback level (pending limit order)"], group = G_TIME, tooltip = "Fill bar close: the honest price for a MARKET order sent at bar close. Use this unless your TVMT bridge places pending orders.\nPullback level: sends the exact retrace price, which is only correct if TVMT places a pending LIMIT order.", display = display.none)
coolBars    = input.int(10, "Cooldown After A Signal (bars)", minval = 0, group = G_TIME, tooltip = "Minimum bars between two accepted signals. This is what stops the machine-gun clusters of three SELLs in four bars.", display = display.none)
useMinSl    = input.bool(false, "Floor The Stop At A Minimum ATR Distance", group = G_TIME, tooltip = "Widens the stop whenever your fixed pip distance is tighter than normal noise for the current volatility. On XAUUSD 15m a 500 pip (5.00) stop is only about 1 ATR, which ordinary chop takes out. Turn on and compare.", display = display.none)
minSlAtr    = input.float(1.5, "Minimum Stop Distance (x ATR)", minval = 0.1, step = 0.1, group = G_TIME, tooltip = "Only applies when the floor above is enabled, and it can only widen the stop, never tighten it. Take profits are left where you set them, so this lowers R:R - check the dashboard before keeping it.", display = display.none)

// -----------------------------------------------------------------------------
//  2. DISTANCE METHOD INPUTS  (Pip / ATR / Percentage - trader picks one)
// -----------------------------------------------------------------------------
distMethod = input.string("Pip", "Distance Method", options = ["Pip", "ATR", "Percentage"], group = G_DIST, tooltip = "Chosen method applies to SL, TP1, TP2 and TP3 together. All three engines are built in - switch anytime.", display = display.none)

// --- 2a. PIP ENGINE ---
// 1 pip = 10 points, and 1 point = syminfo.mintick (the smallest price step).
//   XAUUSD 2-decimal feed : mintick 0.01   -> pip 0.10
//   XAUUSD 3-decimal feed : mintick 0.001  -> pip 0.01
//   5-digit forex         : mintick 0.00001-> pip 0.0001
//   3-digit JPY forex     : mintick 0.001  -> pip 0.01
// The raw tick is NEVER used as the pip.
pipMode   = input.string("Auto (10 x mintick)", "Pip Size Mode", options = ["Auto (10 x mintick)", "Manual"], group = G_PIP, tooltip = "Auto covers gold, 5-digit forex and 3-digit JPY. Use Manual only if your broker quotes differently.", display = display.none)
manualPip = input.float(0.10, "Manual Pip Size (price units)", minval = 0.0, step = 0.00001, group = G_PIP, tooltip = "Example: 0.10 for a 2-decimal XAUUSD feed, 0.0001 for 5-digit forex.", display = display.none)
slPips    = input.float(150.0, "Stop Loss (pips)", minval = 0.0, step = 1.0, group = G_PIP, display = display.none)
tp1Pips   = input.float(150.0, "Take Profit 1 (pips)", minval = 0.0, step = 1.0, group = G_PIP, display = display.none)
tp2Pips   = input.float(300.0, "Take Profit 2 (pips)", minval = 0.0, step = 1.0, group = G_PIP, display = display.none)
tp3Pips   = input.float(450.0, "Take Profit 3 (pips)", minval = 0.0, step = 1.0, group = G_PIP, display = display.none)

// --- 2b. ATR ENGINE ---
atrLength = input.int(14, "ATR Length", minval = 1, group = G_ATR, display = display.none)
slAtr     = input.float(1.5, "Stop Loss (x ATR)", minval = 0.0, step = 0.1, group = G_ATR, display = display.none)
tp1Atr    = input.float(1.5, "Take Profit 1 (x ATR)", minval = 0.0, step = 0.1, group = G_ATR, display = display.none)
tp2Atr    = input.float(3.0, "Take Profit 2 (x ATR)", minval = 0.0, step = 0.1, group = G_ATR, display = display.none)
tp3Atr    = input.float(4.5, "Take Profit 3 (x ATR)", minval = 0.0, step = 0.1, group = G_ATR, display = display.none)

// --- 2c. PERCENTAGE ENGINE ---
slPct  = input.float(0.50, "Stop Loss (%)", minval = 0.0, step = 0.05, group = G_PCT, display = display.none)
tp1Pct = input.float(0.50, "Take Profit 1 (%)", minval = 0.0, step = 0.05, group = G_PCT, display = display.none)
tp2Pct = input.float(1.00, "Take Profit 2 (%)", minval = 0.0, step = 0.05, group = G_PCT, display = display.none)
tp3Pct = input.float(1.50, "Take Profit 3 (%)", minval = 0.0, step = 0.05, group = G_PCT, display = display.none)

// -----------------------------------------------------------------------------
//  3. MARKER STYLE INPUTS  (shape + colour are trader-selectable)
// -----------------------------------------------------------------------------
buyShape   = input.string("Label Up", "Buy Marker Shape", options = ["Label Up", "Triangle Up", "Arrow Up", "Circle", "Diamond", "Flag", "Square", "Cross", "X Cross"], group = G_MARK, display = display.none)
sellShape  = input.string("Label Down", "Sell Marker Shape", options = ["Label Down", "Triangle Down", "Arrow Down", "Circle", "Diamond", "Flag", "Square", "Cross", "X Cross"], group = G_MARK, display = display.none)
buyColor   = input.color(color.green, "Buy Marker Colour", group = G_MARK, display = display.none)
sellColor  = input.color(color.red, "Sell Marker Colour", group = G_MARK, display = display.none)
buyTxtCol  = input.color(color.white, "Buy Marker Text Colour", group = G_MARK, display = display.none)
sellTxtCol = input.color(color.white, "Sell Marker Text Colour", group = G_MARK, display = display.none)
markSizeI  = input.string("Small", "Marker Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = G_MARK, display = display.none)

// -----------------------------------------------------------------------------
//  4. LINE & LABEL STYLE INPUTS
// -----------------------------------------------------------------------------
entryCol   = input.color(color.yellow, "Entry Line Colour", group = G_LINE, display = display.none)
slCol      = input.color(color.red, "Stop Loss Line Colour", group = G_LINE, display = display.none)
tp1Col     = input.color(color.aqua, "Take Profit 1 Line Colour", group = G_LINE, display = display.none)
tp2Col     = input.color(color.aqua, "Take Profit 2 Line Colour", group = G_LINE, display = display.none)
tp3Col     = input.color(color.aqua, "Take Profit 3 Line Colour", group = G_LINE, display = display.none)
lineWidth  = input.int(1, "Line Width", minval = 1, maxval = 4, group = G_LINE, display = display.none)
lineStyleI = input.string("Solid", "Line Style", options = ["Solid", "Dashed", "Dotted"], group = G_LINE, display = display.none)
rightPad   = input.int(20, "Extend Lines / Labels To The Right (bars)", minval = 1, maxval = 200, group = G_LINE, tooltip = "Lines and labels are re-anchored to the live edge on every bar, so they can never scroll off the screen.", display = display.none)
showLabels = input.bool(true, "Show Level Labels", group = G_LINE, display = display.none)
showPips   = input.bool(true, "Show Distance In Pips On Labels", group = G_LINE, display = display.none)
labSizeI   = input.string("Small", "Label Text Size", options = ["Tiny", "Small", "Normal"], group = G_LINE, display = display.none)

// -----------------------------------------------------------------------------
//  5. DASHBOARD INPUTS
// -----------------------------------------------------------------------------
levelSrc   = input.string("Indicator sends SL / TP to TVMT", "Who Sets SL / TP", options = ["Indicator sends SL / TP to TVMT", "TVMT Trading Setup (indicator levels are display only)"], group = G_ALERT, tooltip = "CHECK THIS AGAINST YOUR TVMT TRADING SETUP PAGE.\nIf TVMT applies its own SL/TP, the levels this script draws are NOT the ones being traded, and the win rate dashboard is measuring a different strategy from your account.\nEither way the fix is the same: type the SAME distances into group 2 that TVMT uses, so chart, dashboard and account all agree.\nTVMT mode drops entry/sl/tp/tp2/tp3 from the payload so there is no ambiguity about which side wins. Applies to the One alert (alert function) method only - alertcondition() messages must be compile-time constants, so the two-alert path always sends levels.", display = display.none)
jsonBraces = input.bool(true, "Wrap Alert JSON In Outer Braces", group = G_ALERT, tooltip = "The TVMT portal shows its own template WITHOUT the outer { } and notes that this stops TradingView flagging the message as JSON. Your current setup sends them and is executing fine, so this defaults to ON - untick it only if TVMT starts rejecting payloads.\nApplies to the One alert (alert function) method only: TradingView requires alertcondition() messages to be compile-time constants, so the two-alert path is always braced.", display = display.none)
alertMode  = input.string("Two alerts (BUY and SELL separately)", "Alert Method", options = ["Two alerts (BUY and SELL separately)", "One alert (alert function)"], group = G_ALERT, tooltip = "Two alerts: create one alert per condition. Both alerts MUST be created with identical indicator settings, or a single cross can trigger both.\nOne alert: create a single alert on 'Any alert() function call'. The script builds the JSON itself, so only one message is ever sent and the action always matches the marker. Immune to the double-fire problem.", display = display.none)
// -----------------------------------------------------------------------------
//  7. EXECUTION MODEL
//  The dashboard is only worth reading if it exits trades the way TVMT does.
//  Set these to match your TVMT Trading Setup page exactly.
// -----------------------------------------------------------------------------
exitModel = input.string("Single TP (TVMT ladder OFF)", "Exit Model", options = ["Single TP (TVMT ladder OFF)", "TP ladder 33/33/34 (TVMT ladder ON)"], group = G_EXEC, tooltip = "Single TP: TVMT's Take-Profit Ladder is OFF, so the whole position closes at the alert's tp (TP1) and tp2/tp3 are ignored. Every trade is binary - SL or TP1.\nTP ladder: TVMT's ladder is ON, so the position scales out 33/33/34 at TP1/TP2/TP3 and the stop moves to breakeven at TP1.", display = display.none)
simBE     = input.bool(false, "Simulate Auto Breakeven", group = G_EXEC, tooltip = "Mirrors TVMT's Auto Breakeven block. Turn this on here FIRST and read the expectancy, then decide whether to turn it on in TVMT. In ladder mode the stop always moves to breakeven at TP1, exactly as TVMT does.", display = display.none)
beTrigR   = input.float(0.4, "Breakeven Trigger (x SL distance)", minval = 0.05, step = 0.05, group = G_EXEC, tooltip = "Expressed as a fraction of your stop distance so it is unit-free. TVMT states this in ITS pips, which may not equal this script's pip - 0.4 here means 40% of the way to a full stop loss in profit.", display = display.none)
beOffR    = input.float(0.0, "Breakeven SL Offset (x SL distance)", minval = 0.0, step = 0.05, group = G_EXEC, tooltip = "Where the stop lands once breakeven arms. 0 = exactly at entry.", display = display.none)

showDash   = input.bool(true, "Show Win Rate Dashboard", group = G_DASH, display = display.none)
dashSizeI  = input.string("Small", "Dashboard Text Size", options = ["Tiny", "Small", "Normal"], group = G_DASH, display = display.none)
dashBg     = input.color(color.new(color.black, 20), "Dashboard Background", group = G_DASH, display = display.none)
dashTxt    = input.color(color.white, "Dashboard Text Colour", group = G_DASH, display = display.none)
dashWinCol = input.color(color.lime, "Dashboard Win Colour", group = G_DASH, display = display.none)
dashLosCol = input.color(color.red, "Dashboard Loss Colour", group = G_DASH, display = display.none)

// =============================================================================
//  STYLE HELPERS - turn the text choices above into real Pine constants
// =============================================================================
lineStyleV = lineStyleI == "Dashed" ? line.style_dashed : lineStyleI == "Dotted" ? line.style_dotted : line.style_solid
labSizeV   = labSizeI  == "Tiny" ? size.tiny : labSizeI  == "Normal" ? size.normal : size.small
dashSizeV  = dashSizeI == "Tiny" ? size.tiny : dashSizeI == "Normal" ? size.normal : size.small
markerSizeV = markSizeI == "Tiny" ? size.tiny : markSizeI == "Normal" ? size.normal : markSizeI == "Large" ? size.large : size.small

// =============================================================================
//  IMPULSE MACD ENGINE (LazyBear logic, converted to Pine v6)
// =============================================================================

// Smoothed moving average used for the high & low impulse bands.
// LazyBear's original loop was:  smma = (smma[1] * (len - 1) + src) / len
// seeded with an SMA. ta.rma() is exactly that same Wilder smoothing, but it
// carries no self-referencing series, which avoids the "Pine cannot determine
// the referencing length of series" runtime error when the script is attached.
calc_smma(float source, simple int len) =>
    ta.rma(source, len)

// Zero-lag EMA used for the mid line.
calc_zlema(float source, simple int len) =>
    float ema1 = ta.ema(source, len)
    float ema2 = ta.ema(ema1, len)
    float d = ema1 - ema2
    ema1 + d

float hiBand = calc_smma(high, lengthMA)     // upper impulse band
float loBand = calc_smma(low, lengthMA)      // lower impulse band
float mid    = calc_zlema(srcInput, lengthMA) // zero-lag mid line

// md = the Impulse MACD value. It is 0 while price sits inside the bands.
float md = mid > hiBand ? mid - hiBand : mid < loBand ? mid - loBand : 0.0
float sb = ta.sma(md, lengthSignal)          // signal line

// -----------------------------------------------------------------------------
//  RAW SIGNALS - one pair per mode, the dropdown picks which pair is used
//
//  WHY NOT ta.crossover()?  ta.crossover(a, b) needs a to be strictly BELOW b
//  on the previous bar and strictly ABOVE it now. When the Impulse MACD sits at
//  exactly 0 (price inside the bands), md is 0 and sb - its own average - is 0
//  too. The two lines sit ON TOP of each other at the zero level, which LOOKS
//  like a crossing on the chart but registers as no cross at all, because
//  neither is ever strictly above the other. That is why signals only appeared
//  at the moments the lines happened to separate.
//
//  f_signFlip fixes that. It watches the SIGN of (line1 - line2) and fires the
//  moment that sign flips, ignoring any flat stretch at zero in between. So a
//  cross is detected whenever the lines genuinely swap places, whether they
//  crossed cleanly or sat together at zero first.
// -----------------------------------------------------------------------------
f_signFlip(float d, bool confirmed) =>
    int cur = d > 0 ? 1 : d < 0 ? -1 : 0
    var int last = 0
    bool up = false
    bool dn = false
    if confirmed and cur != 0
        if last != 0 and cur != last
            up := cur == 1
            dn := cur == -1
        last := cur
    [up, dn]

// PRICE MA MODE: fast EMA above slow EMA = BUY.
float fastMA = ta.ema(srcInput, lengthSignal)
float slowMA = ta.ema(srcInput, lengthMA)
[maUp, maDn] = f_signFlip(fastMA - slowMA, barstate.isconfirmed)

// IMPULSE MODE (default): signal line crossing ABOVE the Impulse MACD = BUY.
[sigUp, sigDn] = f_signFlip(sb - md, barstate.isconfirmed)

// REVERSED ORIENTATION: Impulse MACD crossing ABOVE its signal line = BUY.
[macdUp, macdDn] = f_signFlip(md - sb, barstate.isconfirmed)

// ZERO LINE: Impulse MACD turning positive = BUY.
[zeroUp, zeroDn] = f_signFlip(md, barstate.isconfirmed)

bool modeUp = signalMode == "Zero Line Cross" ? zeroUp : signalMode == "MACD crosses Signal Line" ? macdUp : signalMode == "Fast MA crosses Slow MA (price)" ? maUp : sigUp
bool modeDn = signalMode == "Zero Line Cross" ? zeroDn : signalMode == "MACD crosses Signal Line" ? macdDn : signalMode == "Fast MA crosses Slow MA (price)" ? maDn : sigDn

// Master invert. Swaps the two sides in whichever mode is selected.
bool rawBuy  = invertSig ? modeDn : modeUp
bool rawSell = invertSig ? modeUp : modeDn

// Optional MA plots. display.pane draws them on the chart but keeps their
// values OUT of the status line, so the legend stays clean.
bool maModeOn = signalMode == "Fast MA crosses Slow MA (price)" and showMAs
plot(maModeOn ? fastMA : na, title = "Fast MA", color = fastMACol, linewidth = 1, display = display.pane)
plot(maModeOn ? slowMA : na, title = "Slow MA", color = slowMACol, linewidth = 1, display = display.pane)

// =============================================================================
//  ENTRY TIMING PIPELINE
//  -------------------------------------------------------------------------
//  Everything below exists to separate WHICH WAY to trade from WHEN to enter.
//  The cross above answers the first question. It used to answer the second one
//  too, and that is what produced entries at the exact end of a leg.
//
//     raw cross -> trend -> extension -> cooldown -> ARM -> pullback -> FILL
//
//  buySignal / sellSignal now fire on the FILL bar, not on the cross bar. Every
//  downstream consumer (markers, levels, alerts, dashboard) is unchanged and
//  simply inherits the better timing.
// =============================================================================
float atrVal = ta.atr(atrLength)

// --- guard 1: TREND. Only take the cross that agrees with the bigger move. ---
float trendEma   = ta.ema(close, trendLen)
float trendSlope = nz(trendEma - trendEma[1], 0.0)
bool trendBuyOk  = not useTrend or (close > trendEma and trendSlope >= 0.0)
bool trendSellOk = not useTrend or (close < trendEma and trendSlope <= 0.0)

// --- guard 2: EXTENSION. How far has this leg ALREADY run, measured in ATR? --
//  This is the direct answer to "the signal comes at the end of the move".
//  A cross that only confirms once price is 3 ATR from the mid line is
//  reporting a move that is over. Refuse it rather than chase it.
float extAtr     = atrVal > 0.0 ? math.abs(close - mid) / atrVal : 0.0
bool notExtended = not useExtFilt or extAtr <= maxExtAtr

// --- guard 3: the original impulse-zone filter (behaviour unchanged) ---
bool zoneBuyOk  = not useZone or srcInput > mid
bool zoneSellOk = not useZone or srcInput < mid

// --- guard 4: COOLDOWN. Stops the script re-firing on every micro wiggle. ---
var int lastSigBar = -1000000
bool coolOk = coolBars <= 0 or (bar_index - lastSigBar) >= coolBars

// NO REPAINT GATE: the bar must be finished before a cross counts.
// A candidate is a cross that survived every guard. It still is not a trade.
bool candBuy  = rawBuy  and zoneBuyOk  and trendBuyOk  and notExtended and coolOk and barstate.isconfirmed
bool candSell = rawSell and zoneSellOk and trendSellOk and notExtended and coolOk and barstate.isconfirmed and not candBuy

// -----------------------------------------------------------------------------
//  ARM / FILL STATE MACHINE
//  A surviving cross parks a target price and waits for price to come back to
//  it, the way a resting limit order would. A new cross in either direction
//  cancels whatever was parked, so only one order is ever pending.
// -----------------------------------------------------------------------------
var int   armDir   = 0
var float armPrice = na
var int   armBar   = 0
var int   armedCount   = 0
var int   expiredCount = 0

float pbDist = usePullback ? pbAtr * nz(atrVal, 0.0) : 0.0

if candBuy
    armDir   := 1
    armPrice := close - pbDist
    armBar   := bar_index
    armedCount += 1
else if candSell
    armDir   := -1
    armPrice := close + pbDist
    armBar   := bar_index
    armedCount += 1

bool fillBuy  = false
bool fillSell = false

if barstate.isconfirmed and armDir != 0
    bool sameBar = bar_index == armBar
    if not usePullback and sameBar
        // Pullback disabled -> fire on the cross bar, exactly like the old script.
        fillBuy  := armDir == 1
        fillSell := armDir == -1
    else if not sameBar
        // Limit-style fill: a buy needs price to trade back DOWN to the level,
        // a sell needs it to trade back UP. The arm bar itself cannot fill,
        // because its low/high already happened before the order existed.
        if armDir == 1 and low <= armPrice
            fillBuy := true
        else if armDir == -1 and high >= armPrice
            fillSell := true

// The parked order expires unfilled once its window runs out. No trade is taken.
bool armExpired = armDir != 0 and not fillBuy and not fillSell and barstate.isconfirmed and (bar_index - armBar) >= pbBars
if armExpired
    expiredCount += 1

// Optional "one signal per direction" filter (wait for the opposite side).
var int lastDir = 0
bool buySignal  = fillBuy  and (not flipOnly or lastDir != 1)
bool sellSignal = fillSell and (not flipOnly or lastDir != -1)   // never both on one bar

if buySignal
    lastDir    := 1
    lastSigBar := bar_index
else if sellSignal
    lastDir    := -1
    lastSigBar := bar_index

// Clear the parked order once it filled, was blocked by flipOnly, or expired.
if fillBuy or fillSell or armExpired
    armDir := 0

// -----------------------------------------------------------------------------
//  DIAGNOSTIC COUNTERS - this is how you tune the four guards above.
//    Raw Crosses = crosses the engine found, before anything is applied.
//    Blk T/E/C   = crosses thrown away by Trend / Extension / Cooldown.
//    Armed       = crosses that survived and parked an order.
//    Filled      = parked orders that got their pullback -> the real signals.
//    Expired     = parked orders that never got a pullback -> no trade taken.
//  Filled far too small? Loosen: raise Max Distance, raise Pullback Window, or
//  lower Pullback Depth. Win rate still poor? Tighten the same three instead.
//  Blk counts are attributed in guard order, so each cross is counted once.
// -----------------------------------------------------------------------------
var int rawCount   = 0
var int firedCount = 0
var int mdLiveBars = 0
var int blkTrend   = 0
var int blkExt     = 0
var int blkCool    = 0

if barstate.isconfirmed
    if rawBuy or rawSell
        rawCount += 1
        bool tOk = rawBuy ? trendBuyOk : trendSellOk
        if not tOk
            blkTrend += 1
        else if not notExtended
            blkExt += 1
        else if not coolOk
            blkCool += 1
    if md != 0.0
        mdLiveBars += 1

// =============================================================================
//  DISTANCE ENGINES - Pip / ATR / Percentage
// =============================================================================
// Pip size in PRICE units. Auto = 10 points = 10 * mintick.
float pipPrice = pipMode == "Manual" ? manualPip : 10.0 * syminfo.mintick

// One helper used by all four levels, so switching method changes everything.
f_dist(string method, float pipsVal, float atrMult, float pctVal, float entryP) =>
    float d = method == "Pip" ? pipsVal * pipPrice : method == "ATR" ? atrVal * atrMult : entryP * pctVal / 100.0
    d

// =============================================================================
//  LEVEL CAPTURE (only on a confirmed signal bar)
// =============================================================================
var float pEntry = na
var float pSL    = na
var float pTP1   = na
var float pTP2   = na
var float pTP3   = na
var int   pDir   = 0        // +1 long setup, -1 short setup

bool newSignal = buySignal or sellSignal

if newSignal
    firedCount += 1

if newSignal
    // Entry reference. A market order sent at bar close fills at that close, so
    // that is the honest number to report. Only switch to the parked pullback
    // level if your TVMT bridge actually places a pending LIMIT order.
    float entryP = (usePullback and entryRef == "Pullback level (pending limit order)") ? armPrice : close
    float dSL  = f_dist(distMethod, slPips,  slAtr,  slPct,  entryP)
    float dT1  = f_dist(distMethod, tp1Pips, tp1Atr, tp1Pct, entryP)
    float dT2  = f_dist(distMethod, tp2Pips, tp2Atr, tp2Pct, entryP)
    float dT3  = f_dist(distMethod, tp3Pips, tp3Atr, tp3Pct, entryP)

    // Optional volatility floor on the stop. It can only ever widen the stop.
    if useMinSl
        dSL := math.max(dSL, minSlAtr * nz(atrVal, 0.0))
    pDir   := buySignal ? 1 : -1
    pEntry := entryP
    pSL    := buySignal ? entryP - dSL : entryP + dSL
    pTP1   := buySignal ? entryP + dT1 : entryP - dT1
    pTP2   := buySignal ? entryP + dT2 : entryP - dT2
    pTP3   := buySignal ? entryP + dT3 : entryP - dT3

// =============================================================================
//  DRAWINGS - only the LATEST setup is kept on the chart
// =============================================================================
var line lnE = na
var line lnS = na
var line lnT1 = na
var line lnT2 = na
var line lnT3 = na
var label lbE = na
var label lbS = na
var label lbT1 = na
var label lbT2 = na
var label lbT3 = na

// Build the text for a level label, e.g.  "TP1  2665.00  (+150.0 pips)"
f_labTxt(string name, float price, float entryP) =>
    string txt = name + "  " + str.tostring(price, format.mintick)
    if showPips and pipPrice > 0
        float pips = math.abs(price - entryP) / pipPrice
        txt := txt + "  (" + str.tostring(pips, "#.#") + " pips)"
    txt

if newSignal
    // delete the previous setup first
    line.delete(lnE)
    line.delete(lnS)
    line.delete(lnT1)
    line.delete(lnT2)
    line.delete(lnT3)
    label.delete(lbE)
    label.delete(lbS)
    label.delete(lbT1)
    label.delete(lbT2)
    label.delete(lbT3)

    int x2 = bar_index + rightPad
    lnE  := line.new(bar_index, pEntry, x2, pEntry, color = entryCol)
    lnS  := line.new(bar_index, pSL,    x2, pSL,    color = slCol)
    lnT1 := line.new(bar_index, pTP1,   x2, pTP1,   color = tp1Col)
    lnT2 := line.new(bar_index, pTP2,   x2, pTP2,   color = tp2Col)
    lnT3 := line.new(bar_index, pTP3,   x2, pTP3,   color = tp3Col)

    // apply the chosen style/width through the setters (safe with variables)
    line.set_style(lnE,  lineStyleV)
    line.set_style(lnS,  lineStyleV)
    line.set_style(lnT1, lineStyleV)
    line.set_style(lnT2, lineStyleV)
    line.set_style(lnT3, lineStyleV)
    line.set_width(lnE,  lineWidth)
    line.set_width(lnS,  lineWidth)
    line.set_width(lnT1, lineWidth)
    line.set_width(lnT2, lineWidth)
    line.set_width(lnT3, lineWidth)

    if showLabels
        lbE  := label.new(x2, pEntry, f_labTxt("ENTRY", pEntry, pEntry), style = label.style_label_left, color = color.new(color.black, 100), textcolor = entryCol)
        lbS  := label.new(x2, pSL,    f_labTxt("SL",    pSL,    pEntry), style = label.style_label_left, color = color.new(color.black, 100), textcolor = slCol)
        lbT1 := label.new(x2, pTP1,   f_labTxt("TP1",   pTP1,   pEntry), style = label.style_label_left, color = color.new(color.black, 100), textcolor = tp1Col)
        lbT2 := label.new(x2, pTP2,   f_labTxt("TP2",   pTP2,   pEntry), style = label.style_label_left, color = color.new(color.black, 100), textcolor = tp2Col)
        lbT3 := label.new(x2, pTP3,   f_labTxt("TP3",   pTP3,   pEntry), style = label.style_label_left, color = color.new(color.black, 100), textcolor = tp3Col)

        // apply the chosen text size through the setter (safe with variables)
        label.set_size(lbE,  labSizeV)
        label.set_size(lbS,  labSizeV)
        label.set_size(lbT1, labSizeV)
        label.set_size(lbT2, labSizeV)
        label.set_size(lbT3, labSizeV)

// Re-anchor every bar so lines stay extended and labels never scroll off screen.
if not na(lnE)
    int xNow = bar_index + rightPad
    line.set_x2(lnE,  xNow)
    line.set_x2(lnS,  xNow)
    line.set_x2(lnT1, xNow)
    line.set_x2(lnT2, xNow)
    line.set_x2(lnT3, xNow)
    if showLabels and not na(lbE)
        label.set_x(lbE,  xNow)
        label.set_x(lbS,  xNow)
        label.set_x(lbT1, xNow)
        label.set_x(lbT2, xNow)
        label.set_x(lbT3, xNow)

// =============================================================================
//  MARKERS - drawn as LABELS, not plotshapes.
//  TradingView counts every plot output against a hard limit of 64 per script,
//  and a plotshape with a variable colour compiles into THREE outputs (shape,
//  colour, text colour). Nine shape choices x two directions = 54 outputs on
//  their own, which broke the limit (runtime error RE10140).
//  Labels are drawing objects, not plots, so they cost nothing against that
//  limit and still allow the shape AND the colour to be chosen freely.
//  Note: TradingView keeps at most 500 labels, so markers show for the most
//  recent ~500 signals. The five level labels are re-used, not accumulated.
// =============================================================================
f_markerStyle(string s) =>
    switch s
        "Label Up"      => label.style_label_up
        "Label Down"    => label.style_label_down
        "Triangle Up"   => label.style_triangleup
        "Triangle Down" => label.style_triangledown
        "Arrow Up"      => label.style_arrowup
        "Arrow Down"    => label.style_arrowdown
        "Circle"        => label.style_circle
        "Diamond"       => label.style_diamond
        "Flag"          => label.style_flag
        "Square"        => label.style_square
        "Cross"         => label.style_cross
        "X Cross"       => label.style_xcross
        => label.style_label_up

if buySignal
    label.new(bar_index, low, "BUY", yloc = yloc.belowbar, style = f_markerStyle(buyShape), color = buyColor, textcolor = buyTxtCol, size = markerSizeV)

if sellSignal
    label.new(bar_index, high, "SELL", yloc = yloc.abovebar, style = f_markerStyle(sellShape), color = sellColor, textcolor = sellTxtCol, size = markerSizeV)

// =============================================================================
//  ALERT PLOTS - read by {{plot("title")}}, matched by TITLE not by number.
//  display.none keeps them off the chart; TradingView still feeds them to the
//  alert placeholders. nz(..., close) guarantees a finite number, never na.
// =============================================================================
plot(nz(pEntry, close), title = "entry", display = display.none)
plot(nz(pSL,    close), title = "sl",    display = display.none)
plot(nz(pTP1,   close), title = "tp",    display = display.none)   // "tp" carries TP1
plot(nz(pTP2,   close), title = "tp2",   display = display.none)
plot(nz(pTP3,   close), title = "tp3",   display = display.none)

// =============================================================================
//  TVMT WEBHOOK ALERTS - exact JSON, nothing else in the message box.
//  Set the alert trigger to "Once Per Bar Close".
// =============================================================================
alertcondition(buySignal, title = "MFZ BUY (TVMT)", message = '{\n  "symbol": "{{ticker}}",\n  "action": "buy",\n  "entry": {{plot("entry")}},\n  "sl": {{plot("sl")}},\n  "tp": {{plot("tp")}},\n  "tp2": {{plot("tp2")}},\n  "tp3": {{plot("tp3")}},\n  "tv_time": "{{timenow}}",\n  "tv_alert_id": "tv-{{ticker}}-buy-{{time}}"\n}')

alertcondition(sellSignal, title = "MFZ SELL (TVMT)", message = '{\n  "symbol": "{{ticker}}",\n  "action": "sell",\n  "entry": {{plot("entry")}},\n  "sl": {{plot("sl")}},\n  "tp": {{plot("tp")}},\n  "tp2": {{plot("tp2")}},\n  "tp3": {{plot("tp3")}},\n  "tv_time": "{{timenow}}",\n  "tv_alert_id": "tv-{{ticker}}-sell-{{time}}"\n}')

// -----------------------------------------------------------------------------
//  SINGLE-ALERT PATH - identical JSON, but built inside Pine.
//  Only fires when Alert Method is "One alert (alert function)". Because the
//  script writes the message itself, exactly ONE payload is sent per signal and
//  its "action" always matches the marker on the chart.
//  Set the alert up as: Condition "BYA IMACD1" -> "Any alert() function call".
// -----------------------------------------------------------------------------
bool sendLevels = levelSrc == "Indicator sends SL / TP to TVMT"

f_json(string action) =>
    string j = jsonBraces ? '{\n' : ''
    j += '  "symbol": "' + syminfo.ticker + '",\n'
    j += '  "action": "' + action + '",\n'
    // Levels are omitted entirely when TVMT owns them, so the bridge cannot be
    // fed one set of numbers while the Trading Setup page applies another.
    if sendLevels
        j += '  "entry": ' + str.tostring(nz(pEntry, close), format.mintick) + ',\n'
        j += '  "sl": '    + str.tostring(nz(pSL,    close), format.mintick) + ',\n'
        j += '  "tp": '    + str.tostring(nz(pTP1,   close), format.mintick) + ',\n'
        j += '  "tp2": '   + str.tostring(nz(pTP2,   close), format.mintick) + ',\n'
        j += '  "tp3": '   + str.tostring(nz(pTP3,   close), format.mintick) + ',\n'
    j += '  "tv_time": "' + str.format_time(timenow, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + '",\n'
    j += '  "tv_alert_id": "tv-' + syminfo.ticker + '-' + action + '-' + str.tostring(time) + '"\n'
    j += jsonBraces ? '}' : ''
    j

if alertMode == "One alert (alert function)"
    if buySignal
        alert(f_json("buy"), alert.freq_once_per_bar_close)
    else if sellSignal
        alert(f_json("sell"), alert.freq_once_per_bar_close)

// =============================================================================
//  WIN RATE DASHBOARD
//  Walks one virtual trade at a time forward through the loaded history using
//  the indicator's OWN signals and the SAME SL / TP levels drawn on the chart.
//  SL before TP1 = Loss. TP1 or better = Win. It is a quick overview, not a
//  tick-precise backtester: when one bar touches both sides we estimate the
//  order from the bar's open / high / low.
// =============================================================================
var int   vDir   = 0
var float vEntry = na
var float vSL    = na
var float vT1    = na
var float vT2    = na
var float vT3    = na
var float vR     = na       // one R = the stop distance of this trade
var bool  vGotT1 = false
var bool  vGotT2 = false
var bool  vGotT3 = false
var bool  vArmed = false    // stop has been moved to breakeven
var float vBank  = 0.0      // R already realised from partial exits

var int   totalTrades = 0
var int   winCount    = 0
var int   lossCount   = 0
var int   slCount     = 0
var int   t1Count     = 0
var int   t2Count     = 0
var int   t3Count     = 0
var float sumR        = 0.0 // total R across every closed trade

bool ladderOn = exitModel == "TP ladder 33/33/34 (TVMT ladder ON)"

// NOTE: a Pine user-defined function may read globals but may NOT assign to
// them, so the trade accounting cannot be factored into a helper. Each branch
// below sets bookR and done, and the booking happens once afterwards.

if showDash and barstate.isconfirmed
    // ---- 1) walk the open virtual trade forward with this bar's range ----
    if vDir != 0
        // R multiples of each target, so every trade is scored on one scale.
        float r1 = (vT1 - vEntry) * vDir / vR
        float r2 = (vT2 - vEntry) * vDir / vR
        float r3 = (vT3 - vEntry) * vDir / vR

        float beSL  = vEntry + vDir * beOffR * vR
        float curSL = vArmed ? beSL : vSL

        bool slHit = vDir == 1 ? low  <= curSL : high >= curSL
        bool t1Hit = vDir == 1 ? high >= vT1 : low  <= vT1
        bool t2Hit = vDir == 1 ? high >= vT2 : low  <= vT2
        bool t3Hit = vDir == 1 ? high >= vT3 : low  <= vT3

        // Same-bar ambiguity: assume the level nearer to the open was hit first.
        bool slFirst = slHit and t1Hit ? math.abs(open - curSL) <= math.abs(open - vT1) : slHit
        bool  done  = false
        float bookR = 0.0

        if not ladderOn
            // TVMT ladder OFF: the whole position closes at the alert's tp.
            // tp2 and tp3 are never sent to the broker, so they cannot be hit.
            if slFirst
                if not vArmed
                    slCount += 1
                bookR := vArmed ? beOffR : -1.0
                done  := true
            else if t1Hit
                t1Count += 1
                bookR := r1
                done  := true
        else
            // TVMT ladder ON: scale out 33/33/34, stop to breakeven at TP1.
            if slFirst and not vGotT1
                slCount += 1
                bookR := -1.0
                done  := true
            else
                if t1Hit and not vGotT1
                    vGotT1 := true
                    t1Count += 1
                    vBank  += 0.33 * r1
                    vArmed := true
                if t2Hit and not vGotT2 and vGotT1
                    vGotT2 := true
                    t2Count += 1
                    vBank  += 0.33 * r2
                if t3Hit and not vGotT3 and vGotT2
                    vGotT3 := true
                    t3Count += 1
                    vBank  += 0.34 * r3
                    bookR  := vBank
                    done   := true
                if not done and slHit and vGotT1
                    bookR := vBank
                    done  := true

        if done
            totalTrades += 1
            sumR        += bookR
            if bookR > 0.0
                winCount += 1
            else
                lossCount += 1
            vDir := 0
        else if simBE and not vArmed
            // Breakeven arms at the close of the bar that reached the trigger,
            // so it can only protect from the NEXT bar onwards.
            float trigP = vEntry + vDir * beTrigR * vR
            if vDir == 1 ? high >= trigP : low <= trigP
                vArmed := true

    // ---- 2) a new signal closes any open virtual trade and opens the next ----
    // TVMT is set to "Close and reverse", so the remainder exits at market.
    if newSignal
        if vDir != 0
            float held  = 1.0 - ((vGotT1 ? 0.33 : 0.0) + (vGotT2 ? 0.33 : 0.0) + (vGotT3 ? 0.34 : 0.0))
            float revR  = vBank + (close - vEntry) * vDir / vR * held
            totalTrades += 1
            sumR        += revR
            if revR > 0.0
                winCount += 1
            else
                lossCount += 1
        vDir   := pDir
        vEntry := pEntry
        vSL    := pSL
        vT1    := pTP1
        vT2    := pTP2
        vT3    := pTP3
        vR     := math.max(math.abs(pEntry - pSL), syminfo.mintick)  // never divide by zero
        vGotT1 := false
        vGotT2 := false
        vGotT3 := false
        vArmed := false
        vBank  := 0.0

// ---- 3) render the table in the TOP-RIGHT corner on the last bar ----
var table dash = table.new(position.top_right, 2, 18, border_width = 1)

f_pct(int part, int total) =>
    float p = part          // cast to float first: int / int is integer division in Pine
    float t = total
    t > 0 ? str.tostring(p / t * 100.0, "#.#") + " %" : "-"

if barstate.islast and showDash
    float fWins  = winCount     // cast to float: int / int would truncate to 0
    float fTotal = totalTrades
    float winRate = fTotal > 0 ? fWins / fTotal * 100.0 : 0.0
    color rateCol = winRate >= 50.0 ? dashWinCol : dashLosCol

    // EXPECTANCY is the number that decides everything. A 36% win rate is fine
    // at 3R and fatal at 1.4R, so win rate alone cannot tell you if this works.
    float expR    = fTotal > 0 ? sumR / fTotal : 0.0
    color expCol  = expR > 0.0 ? dashWinCol : dashLosCol

    table.cell(dash, 0, 0, "BYA IMACD1", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 0, (ladderOn ? "LADDER" : "1-TP") + (sendLevels ? " IND" : " TVMT"), text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 0, 1, "Signals",  text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 1, str.tostring(totalTrades), text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 0, 2, "Wins",     text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 2, str.tostring(winCount), text_color = dashWinCol, bgcolor = dashBg)
    table.cell(dash, 0, 3, "Losses",   text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 3, str.tostring(lossCount), text_color = dashLosCol, bgcolor = dashBg)
    table.cell(dash, 0, 4, "Win Rate", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 4, str.tostring(winRate, "#.#") + " %", text_color = rateCol, bgcolor = dashBg)
    table.cell(dash, 0, 5, "Expectancy", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 5, str.tostring(expR, "#.###") + " R", text_color = expCol, bgcolor = dashBg)
    table.cell(dash, 0, 6, "Total R",  text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 6, str.tostring(sumR, "#.#") + " R", text_color = sumR > 0.0 ? dashWinCol : dashLosCol, bgcolor = dashBg)
    table.cell(dash, 0, 7, "SL Hit",   text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 7, f_pct(slCount, totalTrades), text_color = slCol, bgcolor = dashBg)
    table.cell(dash, 0, 8, "TP1 Hit",  text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 8, f_pct(t1Count, totalTrades), text_color = tp1Col, bgcolor = dashBg)
    // TP2/TP3 stay at zero while the exit model is Single TP - that is correct,
    // TVMT never sends those targets to the broker when its ladder is off.
    table.cell(dash, 0, 9, "TP2 Hit",  text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 9, ladderOn ? f_pct(t2Count, totalTrades) : "off", text_color = tp2Col, bgcolor = dashBg)
    table.cell(dash, 0, 10, "TP3 Hit", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 10, ladderOn ? f_pct(t3Count, totalTrades) : "off", text_color = tp3Col, bgcolor = dashBg)
    table.cell(dash, 0, 11, "Raw Crosses", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 11, str.tostring(rawCount), text_color = rawCount > 0 ? dashTxt : dashLosCol, bgcolor = dashBg)
    table.cell(dash, 0, 12, "Blk T/E/C", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 12, str.tostring(blkTrend) + "/" + str.tostring(blkExt) + "/" + str.tostring(blkCool), text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 0, 13, "Armed",   text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 13, str.tostring(armedCount), text_color = armedCount > 0 ? dashTxt : dashLosCol, bgcolor = dashBg)
    table.cell(dash, 0, 14, "Filled",  text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 14, str.tostring(firedCount), text_color = firedCount > 0 ? dashTxt : dashLosCol, bgcolor = dashBg)
    table.cell(dash, 0, 15, "Expired", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 15, str.tostring(expiredCount), text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 0, 16, "Bars md != 0", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 16, str.tostring(mdLiveBars), text_color = mdLiveBars > 0 ? dashTxt : dashLosCol, bgcolor = dashBg)
    // The distances actually being scored. These must equal your TVMT setup.
    table.cell(dash, 0, 17, distMethod + " SL/TP1", text_color = dashTxt, bgcolor = dashBg)
    table.cell(dash, 1, 17, na(pEntry) ? "-" : str.tostring(math.abs(pEntry - pSL), format.mintick) + "/" + str.tostring(math.abs(pTP1 - pEntry), format.mintick), text_color = sendLevels ? dashTxt : dashLosCol, bgcolor = dashBg)

    // apply the chosen dashboard text size to every cell (safe with variables)
    for r = 0 to 17
        for c = 0 to 1
            table.cell_set_text_size(dash, c, r, dashSizeV)
